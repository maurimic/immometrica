# ==============================================================================
# IMMOMETRICA - BEISPIEL-KONFIGURATION (.env.example)
# ==============================================================================
# Kopiere diese Datei nach .env und passe deine Zugangsdaten an:
APP_USERNAME=admin
APP_PASSWORD=dein-geheimes-passwort

# Session Secret (32 Zeichen empfohlen)
SESSION_SECRET=change-me-to-a-random-secret-key-32chars

# Server-Konfiguration
HOST=127.0.0.1
PORT=8000

# Optional: Scraping-Gateway gegen DataDome Bot-Schutz (z.B. ScraperAPI, ZenRows, ScrapingBee)
# Registriere einen kostenlosen Account (z.B. scraperapi.com) und trage den Key hier ein:
SCRAPER_API_KEY=
SCRAPING_SERVICE=scraperapi
SCRAPER_PROXY_URL=
# Kostenkontrolle für ScraperAPI: Direct-First (0 Credits), Standard (10 Cr) vor Premium-Fallback (20 Cr)
SCRAPER_DIRECT_FIRST=1
SCRAPER_PREMIUM_MODE=fallback
SCRAPER_API_ENABLED=1
SCRAPER_CANARY_USE_GATEWAY=1
